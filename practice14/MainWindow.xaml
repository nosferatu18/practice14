<Window x:Class="practice14.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:practice14"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <TextBox 
        Grid.Column="0"
        Grid.Row="0"
        Grid.ColumnSpan="4"
        FontSize="20"
        FontWeight="Bold"
        Background="LightPink"
        Foreground="AntiqueWhite"
        Name="SentenceTb"/>

        <TextBox
        Grid.Column="0"
        Grid.Row="6"
        Grid.ColumnSpan="4"
        Background="DeepPink"
        Name="SentenceTbl"
        Foreground="AntiqueWhite"
        Text="Результат"
        FontSize="24"
        VerticalAlignment="Center"
        HorizontalAlignment="Center"
        Height="62"
        Width="533"/>



        <Button
        Grid.Column="0"
        Grid.Row="1"
        Content="0"
        FontSize="24"
        Background="HotPink"
        Foreground="AntiqueWhite"
        Click="NumberButton_Click"/>

        <Button
        Grid.Column="1"
        Grid.Row="1"
        Content="1"
        FontSize="24"
        Background="HotPink"
        Foreground="AntiqueWhite"
        Click="NumberButton_Click"/>

        <Button
        Grid.Column="2"
        Grid.Row="1"
        Content="2"
        FontSize="24"
        Background="HotPink"
        Foreground="AntiqueWhite"
        Click="NumberButton_Click"/>

        <Button
        Grid.Column="0"
        Grid.Row="2"
        Content="3"
        FontSize="24"
        Background="HotPink"
        Foreground="AntiqueWhite"
        Click="NumberButton_Click"/>

        <Button
        Grid.Column="1"
        Grid.Row="2"
        Content="4"
        FontSize="24"
        Background="HotPink"
        Foreground="AntiqueWhite"
        Click="NumberButton_Click"/>

        <Button
        Grid.Column="2"
        Grid.Row="2"
        Content="5"
        FontSize="24"
        Background="HotPink"
        Foreground="AntiqueWhite"
        Click="NumberButton_Click"/>

        <Button
        Grid.Column="0"
        Grid.Row="3"
        Content="6"
        FontSize="24"
        Background="HotPink"
        Foreground="AntiqueWhite"
        Click="NumberButton_Click"/>

        <Button
        Grid.Column="1"
        Grid.Row="3"
        Content="7"
        FontSize="24"
        Background="HotPink"
        Foreground="AntiqueWhite"
        Click="NumberButton_Click"/>

        <Button
        Grid.Column="2"
        Grid.Row="3"
        Content="8"
        FontSize="24"
        Background="HotPink"
        Foreground="AntiqueWhite"
        Click="NumberButton_Click"/>

        <Button
        Grid.Column="0"
        Grid.Row="4"
        Content="9"
        FontSize="24"
        Background="HotPink"
        Foreground="AntiqueWhite"
        Click="NumberButton_Click"/>


        <Button
        Grid.Column="3"
        Grid.Row="1"
        Content="+"
        FontSize="24"
        Background="HotPink"
        Foreground="AntiqueWhite"
        Click="OperationButton_Click"/>

        <Button
        Grid.Column="3"
        Grid.Row="2"
        Content="-"
        FontSize="24"
        Background="HotPink"
        Foreground="AntiqueWhite"
        Click="OperationButton_Click"/>

        <Button
        Grid.Column="3"
        Grid.Row="3"
        Content="*"
        FontSize="24"
        Background="HotPink"
        Foreground="AntiqueWhite"
        Click="OperationButton_Click"/>

        <Button
        Grid.Column="3"
        Grid.Row="4"
        Content="/"
        FontSize="24"
        Background="HotPink"
        Foreground="AntiqueWhite"
        Click="OperationButton_Click"/>

        <Button
        Grid.Column="1"
        Grid.Row="4"
        Content="C"
        FontSize="24"
        Background="HotPink"
        Foreground="AntiqueWhite"
        Click="ClearButton_Click"/>

        <Button
        Grid.Column="2"
        Grid.Row="4"
        Content="="
        FontSize="24"
        Background="HotPink"
        Foreground="AntiqueWhite"
        Click="EqualsButton_Click"/>
    </Grid>
</Window>